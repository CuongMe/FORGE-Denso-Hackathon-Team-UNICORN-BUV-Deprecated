FORGE_RUNTIME_MODE=production
FORGE_INCLUDE_SOURCE_PACK=1
FORGE_QDRANT_URL=http://127.0.0.1:6333
FORGE_QDRANT_COLLECTION=forge_chunks
FORGE_RETRIEVAL_LIMIT=10
FORGE_RERANK_LIMIT=5
# Tune local CPU embedding throughput; lower this if memory is constrained.
FORGE_EMBED_BATCH_SIZE=64
# Models load from the local Hugging Face cache during normal startup.
FORGE_HF_OFFLINE=1
FORGE_VISUAL_PROVIDER=florence2
FORGE_VISUAL_MODEL=microsoft/Florence-2-base-ft
GEMINI_API_KEY=
FORGE_ADMIN_API_KEY=
