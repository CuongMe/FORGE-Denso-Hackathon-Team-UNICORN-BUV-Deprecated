      "columns": [
        "defect_code",
        "english_name",
        "vietnamese_name",
        "severity",
        "acceptance_criteria"
      ],
      "rows": [
        {
          "defect_code": "D01",
          "english_name": "Surface scratch",
          "vietnamese_name": "Vết xước bề mặt",
          "severity": "Major",
          "acceptance_criteria": "Reject if length > 0.5 mm"
        },
        {
          "defect_code": "D07",
          "english_name": "Bent terminal",
          "vietnamese_name": "Chân terminal cong",
          "severity": "Critical",
          "acceptance_criteria": "Any visible permanent bend"
        },
        {
          "defect_code": "D12",
          "english_name": "Connector latch crack",
          "vietnamese_name": "Nứt lẫy connector",
          "severity": "Critical",
          "acceptance_criteria": "Any crack through latch root"
        },
        {
          "defect_code": "D21",
          "english_name": "Unreadable traceability label",
          "vietnamese_name": "Nhãn truy xuất mờ",
          "severity": "Major",
          "acceptance_criteria": "Barcode/QR not readable after 2 attempts"
        },
        {
          "defect_code": "D31",
          "english_name": "Seal not fully seated",
          "vietnamese_name": "Gioăng chưa vào hết",
          "severity": "Major",
          "acceptance_criteria": "Seal lip must be flush within 0.3 mm"
        }
      ]
    },
