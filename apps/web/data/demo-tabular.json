  "tables": [
    {
      "doc_id": "TBL-DICT-001",
      "source_name": "bilingual_term_dictionary.xlsx",
      "source_path": "data/denso_factory_hack_data_prep/tables/bilingual_term_dictionary.xlsx",
      "columns": [
        "Term ID",
        "English",
        "Vietnamese",
        "Factory context / example"
      ],
      "rows": [
        {
          "Term ID": "T001",
          "English": "quarantine tray",
          "Vietnamese": "khay cách ly",
          "Factory context / example": "Place suspect parts in the red quarantine tray."
        },
        {
          "Term ID": "T002",
          "English": "nonconformance report (NCR)",
          "Vietnamese": "báo cáo không phù hợp (NCR)",
          "Factory context / example": "Create an NCR for a critical defect."
        },
        {
          "Term ID": "T003",
          "English": "torque",
          "Vietnamese": "mô-men siết",
          "Factory context / example": "Target torque is 9.5 ± 0.5 N·m."
        },
        {
          "Term ID": "T004",
          "English": "traceability label",
          "Vietnamese": "nhãn truy xuất",
          "Factory context / example": "Scan the traceability label before release."
        },
        {
          "Term ID": "T005",
          "English": "lockout/tagout (LOTO)",
          "Vietnamese": "khóa và treo thẻ (LOTO)",
          "Factory context / example": "Verify zero energy before work begins."
        },
        {
          "Term ID": "T006",
          "English": "downtime",
          "Vietnamese": "thời gian dừng máy",
          "Factory context / example": "Downtime caused by Sensor S12 was 18 minutes."
        },
        {
          "Term ID": "T007",
          "English": "preventive maintenance",
          "Vietnamese": "bảo trì phòng ngừa",
          "Factory context / example": "Monthly preventive maintenance for SP-04."
        },
        {
          "Term ID": "T008",
          "English": "bent terminal",
          "Vietnamese": "chân terminal cong",
          "Factory context / example": "Bent terminal is defect code D07."
        },
        {
          "Term ID": "T009",
          "English": "first-piece approval",
          "Vietnamese": "phê duyệt sản phẩm đầu tiên",
          "Factory context / example": "Restart only after first-piece approval."
        },
        {
          "Term ID": "T010",
          "English": "changeover",
          "Vietnamese": "chuyển đổi model",
          "Factory context / example": "Model changeover X2 to X3 at 13:20."
        },
        {
          "Term ID": "T011",
          "English": "scrap",
          "Vietnamese": "phế phẩm",
          "Factory context / example": "Scrap was 31 pieces on Shift 1."
        },
        {
          "Term ID": "T012",
          "English": "andon alarm",
          "Vietnamese": "cảnh báo andon",
          "Factory context / example": "Andon alarm A-214 occurred at Station S40."
        }
      ]
    },
    {
      "doc_id": "TBL-DEF-001",
