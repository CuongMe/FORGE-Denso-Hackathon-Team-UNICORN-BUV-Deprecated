{$FORGE_SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000 {
			header_up -Authorization
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up -Authorization
		}
	}
}
