# Copy to .env in the project root. .env is ignored by Git.
# Point this domain at the VM before starting Caddy; open TCP 80 and 443.
FORGE_SITE_ADDRESS=demo.example.com
# Generate a separate random key, for example: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
FORGE_ADMIN_API_KEY=
GEMINI_API_KEY=
# Keep model resolution enabled; downloaded files are reused from the persistent cache.
FORGE_HF_OFFLINE=0
